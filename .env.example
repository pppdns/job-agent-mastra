# Copy the relevant blocks into apps/agent/.env and apps/web/.env.local.
# Placeholders only — never commit real values.

# ---- apps/agent/.env ----
# Vercel AI Gateway (all LLM calls)
AI_GATEWAY_API_KEY=your-ai-gateway-key
# Model IDs for Mastra's model router (Gateway form: vercel/<provider>/<model>)
COPILOT_MODEL=vercel/anthropic/claude-sonnet-5-5
COPILOT_FAST_MODEL=vercel/anthropic/claude-haiku-5-5
# "live" uses real models; "mock" uses a deterministic fake model (tests, offline dev)
LLM_MODE=live
# Shared secret the web app sends to the agent server (any long random string)
AGENT_SHARED_SECRET=change-me-to-a-long-random-string
# Web providers (from M3)
TAVILY_API_KEY=your-tavily-key
FIRECRAWL_API_KEY=your-firecrawl-key

# ---- apps/web/.env.local ----
AGENT_URL=http://127.0.0.1:4111
AGENT_SHARED_SECRET=same-value-as-in-apps-agent
