# Run `pnpm setup:env` to create the shared secret in both files, then add your keys.
# Placeholders only — never commit real values.

# ---- apps/agent/.env ----
# Vercel AI Gateway (all LLM calls)
AI_GATEWAY_API_KEY=your-ai-gateway-key
# Optional: Vercel AI Gateway model ids (<provider>/<model>); these are the defaults
COPILOT_MODEL=anthropic/claude-sonnet-5.5
COPILOT_FAST_MODEL=anthropic/claude-haiku-5.5
# LLM judge for scorers (sampled live turns and `pnpm eval`)
EVAL_JUDGE_MODEL=openai/gpt-6.1-sol
# "live" uses real models; "mock" uses a deterministic fake model (tests, offline dev)
LLM_MODE=live
# Shared secret the web app sends to the agent server (pnpm setup:env generates it)
AGENT_SHARED_SECRET=change-me-to-a-long-random-string
# Web providers (from M3)
TAVILY_API_KEY=your-tavily-key
FIRECRAWL_API_KEY=your-firecrawl-key
# Job discovery (M13). Apify runs the paid board scrapers (LinkedIn); without a key they're skipped.
APIFY_API_KEY=your-apify-token
# Optional free Himalayas key (higher rate limits); the API works without one
HIMALAYAS_API_KEY=
# "on" schedules discovery twice a day, in the main checkout's dev server or the production image
# (Fly). Turn it on in one place only.
DISCOVERY_SCHEDULE=off
DISCOVERY_TZ=Europe/Budapest
# Email digest after each run (Resend). Skipped without the key or a recipient.
RESEND_API_KEY=your-resend-key
DIGEST_TO=you@example.com
# Resend's test sender only delivers to your Resend account's own address
DIGEST_FROM=Job Research Copilot <onboarding@resend.dev>
# Where the email's links point
APP_BASE_URL=http://127.0.0.1:3000

# ---- apps/web/.env.local ----
AGENT_SHARED_SECRET=same-value-as-in-apps-agent
# Optional: turns on the password login page (the Fly deployment sets it; see docs/deploy.md).
# Leave unset locally; sessions are signed with AGENT_SHARED_SECRET.
# APP_PASSWORD=a-long-password-you-choose
