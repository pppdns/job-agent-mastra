{
  "name": "job-research-copilot",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "lint": "biome check .",
    "format": "biome check --write .",
    "check": "biome check . && turbo run typecheck test",
    "e2e": "pnpm --filter @copilot/web e2e",
    "db:migrate": "pnpm --filter @copilot/db migrate",
    "agent:api": "scripts/agent-api.sh"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.4",
    "@types/node": "catalog:",
    "turbo": "^2.11.10",
    "typescript": "catalog:"
  }
}
