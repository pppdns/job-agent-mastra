{
  "name": "job-research-copilot",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "scripts/ports.sh turbo run dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "lint": "biome check .",
    "format": "biome check --write .",
    "check": "biome check . && turbo run typecheck test --output-logs=errors-only",
    "e2e": "scripts/ports.sh pnpm --filter @copilot/web e2e",
    "eval": "pnpm --filter @copilot/agent eval",
    "eval:studio": "scripts/ports.sh pnpm --filter @copilot/agent eval:studio",
    "db:migrate": "pnpm --filter @copilot/db migrate",
    "agent:api": "scripts/ports.sh scripts/agent-api.sh",
    "prepare": "git rev-parse --git-dir >/dev/null 2>&1 || exit 0; git config core.hooksPath .githooks && git config push.autoSetupRemote true",
    "setup:env": "scripts/setup-env.sh",
    "ngrok": "scripts/ports.sh scripts/tunnel.sh",
    "fly:secrets": "scripts/fly-secrets.sh"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.4",
    "@types/node": "catalog:",
    "turbo": "^2.11.10",
    "typescript": "catalog:"
  }
}
